import boto3

from mypy_boto3_iam.client import IAMClient
from secrets import list_secrets, get_secret, set_secret, print_secrets_store
from stubber import stub_client


def rotate_secrets(iam_client: IAMClient):
    """
    This is the function that you are required to implement during the interview. It should read
    all the secrets from the secret store, find any AWS access keys and rotate them. It should
    also write the new keys back to the secrets store.
    """
    # Find all unique IAM usernames by looking for ACCESS_KEY_ID entries
    usernames = []
    for key, value in list_secrets():
        if key.endswith("/AWS_ACCESS_KEY_ID"):
            # Username is <app-name>/<environment>
            parts = key.split("/")
            username = f"{parts[0]}/{parts[1]}"
            usernames.append(username)

    for username in usernames:
        key_prefix = f"{username}/AWS_ACCESS_KEY_ID"
        secret_prefix = f"{username}/AWS_SECRET_ACCESS_KEY"

        # List current access keys for this user
        response = iam_client.list_access_keys(UserName=username)
        old_key_id = response["AccessKeyMetadata"][0]["AccessKeyId"]

        # Create a new access key
        response = iam_client.create_access_key(UserName=username)
        new_key = response["AccessKey"]

        # Update the secret store with the new credentials
        set_secret(key_prefix, new_key["AccessKeyId"])
        set_secret(secret_prefix, new_key["SecretAccessKey"])

        # Delete the old access key
        iam_client.delete_access_key(UserName=username, AccessKeyId=old_key_id)


if __name__ == "__main__":

    iam_client = boto3.client("iam")

    with stub_client(iam_client):
        rotate_secrets(iam_client)

        # We print out the secret store to check that we are setting the expected values
        print_secrets_store()
